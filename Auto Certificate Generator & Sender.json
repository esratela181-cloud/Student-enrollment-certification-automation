        "jsCode": "// Sheet column নামে space/কোলন যা-ই থাকুক, নামের অংশ দিয়ে খুঁজে নেয়\nconst pick = (part) => {\n  const k = Object.keys($json).find(k => k.toLowerCase().includes(part));\n  return k ? String($json[k] ?? '').trim() : '';\n};\n\nconst name = pick('full name') || pick('name');\nconst email = pick('email').toLowerCase();\nconst course = pick('course') || 'Google Analytics Certification Course';\nconst total = pick('total');\nconst mcq = pick('mcq');\nconst short = pick('short');\n\n// certificate ইস্যুর দিন = আজকের তারিখ\nconst dateLong = DateTime.now().setZone('Asia/Dhaka').toFormat('d LLLL yyyy');\n\nreturn { json: {\n  name, email, course, total, mcq, short,\n  scoreText: `${total} / 25`,\n  dateLong,\n}};"
      },
