  </td></tr>\n    </table>\n  </td></tr>\n\n  <!-- Breakdown -->\n  <tr><td style=\"padding:0 28px 8px 28px;\">\n    <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"font-size:14px;\">\n      <tr>\n        <td style=\"padding:10px 12px;background:#111827;border:1px solid #1f2937;color:#9ca3af;\">MCQ Score</td>\n        <td align=\"right\" style=\"padding:10px 12px;background:#111827;border:1px solid #1f2937;color:#ffffff;font-weight:bold;\">{{ $json.mcq_score }} / 10</td>\n      </tr>\n      <tr>\n        <td style=\"padding:10px 12px;background:#111827;border:1px solid #1f2937;color:#9ca3af;\">Short Answer Score</td>\n        <td align=\"right\" style=\"padding:10px 12px;background:#111827;border:1px solid #1f2937;color:#ffffff;font-weight:bold;\">{{ $json.short_total }} / 15</td>\n      </tr>\n    </table>\n  </td></tr>\n\n  <!-- Areas to improve -->\n  <tr><td style=\"padding:18px 28px 8px 28px;\">\n    <div style=\"font-size:14px;letter-spacing:1px;color:#60a5fa;text-transform:uppercase;font-weight:bold;margin-bottom:10px;\">Areas to Improve</div>\n    <ul style=\"margin:0;padding-left:20px;font-size:14px;line-height:1.6;color:#9ca3af;\">\n      {{ [\"q1\",\"q2\",\"q3\",\"q4\",\"q5\"].filter(q => $json.short_scores[q] < 3).map(q => \"<li style='margin-bottom:10px;'><b style='color:#ffffff;'>\" + q.toUpperCase() + \"</b> <span style='color:#3b82f6;'>(\" + $json.short_scores[q] + \"/3)</span><br>\" + $json.feedback[q] + \"</li>\").join(\"\") }}\n    </ul>\n  </td></tr>\n\n  <!-- Retake box -->\n  <tr><td style=\"padding:16px 28px 8px 28px;\">\n    <div style=\"font-size:15px;line-height:1.7;color:#e5e7eb;background:#0b1220;border-left:4px solid #3b82f6;padding:14px 16px;border-radius:6px;\">\n      <b style=\"color:#60a5fa;\">Retake the exam:</b> You can attempt the exam again after 5 days, from <b style=\"color:#ffffff;\">{{ $now.plus({ days: 5 }).toFormat(\"dd LLLL yyyy\") }}</b>. Use this time to revise the topics above.\n    </div>\n  </td></tr>\n\n  <!-- Tips -->\n  <tr><td style=\"padding:16px 28px 8px 28px;\">\n    <div style=\"font-size:14px;letter-spacing:1px;color:#60a5fa;text-transform:uppercase;font-weight:bold;margin-bottom:8px;\">Tips for Your Next Attempt</div>\n    <ul style=\"margin:0;padding-left:20px;font-size:14px;line-height:1.7;color:#9ca3af;\">\n      <li>Write a separate answer for each question. Repeated answers receive 0 marks.</li>\n      <li>Cover all key points, for example definitions, examples and steps.</li>\n      <li>Revise GA4 events, UTM parameters, audiences and conversion setup.</li>\n    </ul>\n  </td></tr>\n\n  <!-- Footer -->\n  <tr><td style=\"padding:22px 28px 28px 28px;border-top:1px solid #1f2937;\">\n    <div style=\"font-size:14px;color:#9ca3af;line-height:1.6;\">We wish you the best for your next attempt.<br><br>Best regards,<br><span style=\"color:#60a5fa;font-weight:bold;\">NextGen Institute</span></div>\n  </td></tr>\n\n</table>\n\n</td></tr>\n</table>\n</div>",
