    {
      "parameters": {
        "jsCode": "const WAIT_DAYS = 30;\nconst ONLY_READY = false; // true দিলে শুধু ৩০ দিন পার হওয়া lead গুলোই পরের node এ যাবে\nconst DAY_MS = 24 * 60 * 60 * 1000;\nconst now = new Date();\nconst out = [];\n\nfor (const item of $input.all()) {\n  const row = item.json;\n  const submitted = new Date(row[\"Date\"]);\n\n  // Date ভুল বা খালি হলে\n  if (isNaN(submitted.getTime())) {\n    out.push({\n      json: {\n        ...row,\n        Email: String(row[\"Email\"] ?? \"\").trim().toLowerCase(),\n        \"Full Name\": String(row[\"Full Name\"] ?? \"\").trim(),\n        isReady: false,\n        reason: \"Invalid or missing Date\",\n      },\n    });\n    continue;\n  }\n\n  const daysPassed = Math.floor((now - submitted) / DAY_MS);\n  const readyOn = new Date(submitted.getTime() + WAIT_DAYS * DAY_MS);\n  const isReady = daysPassed >= WAIT_DAYS;\n\n  out.push({\n    json: {\n      ...row,\n      \"Full Name\": String(row[\"Full Name\"] ?? \"\").trim(),\n      Email: String(row[\"Email\"] ?? \"\").trim().toLowerCase(),\n      submittedAt: submitted.toISOString(),\n      daysPassed,\n      daysRemaining: isReady ? 0 : WAIT_DAYS - daysPassed,\n      readyOn: readyOn.toISOString(),\n      isReady,\n      reason: isReady ? \"30 days passed\" : `Wait ${WAIT_DAYS - daysPassed} more day(s)`,\n    },\n  });\n}\n\nreturn ONLY_READY ? out.filter(i => i.json.isReady) : out;"
      },
