      "parameters": {
        "sendTo": "={{ $json.email }}",
        "subject": "={{ $json.result === \"PASS\" ? \"Congratulations! You Passed the Google Analytics Certification Course\" : \"Your Google Analytics Course Result and Retake Date\" }}",
        "message": "=<div style=\"margin:0;padding:0;background:#05070d;\">\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#05070d;padding:24px 0;\">\n<tr><td align=\"center\">\n\n<table role=\"presentation\" width=\"600\" cellpadding=\"0\" cellspacing=\"0\" style=\"max-width:600px;width:100%;background:#0d1117;border:1px solid #1e3a8a;border-radius:12px;font-family:Arial,Helvetica,sans-serif;color:#e5e7eb;\">\n\n  <!-- Header -->\n  <tr><td style=\"background:#1d4ed8;padding:22px 28px;border-radius:12px 12px 0 0;\">\n    <div style=\"font-size:12px;letter-spacing:2px;color:#bfdbfe;text-transform:uppercase;\">Exam Result</div>\n    <div style=\"font-size:22px;font-weight:bold;color:#ffffff;margin-top:6px;\">Google Analytics Certification Course</div>\n  </td></tr>\n\n  <!-- Greeting -->\n  <tr><td style=\"padding:28px 28px 8px 28px;\">\n    <div style=\"font-size:16px;color:#e5e7eb;\">Hi {{ $json.name }},</div>\n    <div style=\"font-size:15px;line-height:1.6;color:#9ca3af;margin-top:10px;\">\n      Thank you for completing the exam. Here is your final result.\n    </div>\n  </td></tr>\n\n  <!-- Result badge -->\n  <tr><td align=\"center\" style=\"padding:18px 28px;\">\n    <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#111827;border:1px solid {{ $json.result === \"PASS\" ? \"#3b82f6\" : \"#ef4444\" }};border-radius:10px;width:100%;\">\n      <tr><td align=\"center\" style=\"padding:22px;\">\n        <div style=\"font-size:13px;letter-spacing:2px;color:#9ca3af;text-transform:uppercase;\">Your Result</div>\n        <div style=\"font-size:34px;font-weight:bold;color:{{ $json.result === \"PASS\" ? \"#3b82f6\" : \"#ef4444\" }};margin-top:6px;\">{{ $json.result === \"PASS\" ? \"PASSED\" : \"NOT PASSED\" }}</div>\n        <div style=\"font-size:18px;color:#ffffff;margin-top:8px;\">{{ $json.score_text }} &nbsp;•&nbsp; {{ $json.percentage }}%</div>\n        <div style=\"font-size:12px;color:#6b7280;margin-top:6px;\">Pass mark: 15 / 25</div>\n      </td></tr>\n    </table>\n  </td></tr>\n\n  <!-- Score breakdown -->\n  <tr><td style=\"padding:0 28px 8px 28px;\">\n    <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"font-size:14px;\">\n      <tr>\n        <td style=\"padding:10px 12px;background:#111827;border:1px solid #1f2937;color:#9ca3af;\">MCQ Score</td>\n        <td align=\"right\" style=\"padding:10px 12px;background:#111827;border:1px solid #1f2937;color:#ffffff;font-weight:bold;\">{{ $json.mcq_score }} / 10</td>\n      </tr>\n      <tr>\n        <td style=\"padding:10px 12px;background:#111827;border:1px solid #1f2937;color:#9ca3af;\">Short Answer Score</td>\n        <td align=\"right\" style=\"padding:10px 12px;background:#111827;border:1px solid #1f2937;color:#ffffff;font-weight:bold;\">{{ $json.short_total }} / 15</td>\n      </tr>\n    </table>\n  </td></tr>\n\n  <!-- Message -->\n  <tr><td style=\"padding:16px 28px 8px 28px;\">\n    <div style=\"font-size:15px;line-height:1.7;color:#e5e7eb;background:#0b1220;border-left:4px solid {{ $json.result === \"PASS\" ? \"#3b82f6\" : \"#ef4444\" }};padding:14px 16px;border-radius:6px;\">\n      {{ $json.result === \"PASS\"\n        ? \"Congratulations! You have successfully passed the course. <b style='color:#60a5fa;'>Your certificate will be sent to this email address within 1 hour.</b>\"\n        : \"Unfortunately you did not reach the pass mark (15 / 25) this time. Please go through the feedback below to see where you can improve. <b style='color:#f87171;'>You can retake the exam after 5 days, from \" + $now.plus({ days: 5 }).toFormat(\"dd LLLL yyyy\") + \".</b>\" }}\n    </div>\n  </td></tr>\n\n  <!-- Feedback -->\n  <tr><td style=\"padding:18px 28px 8px 28px;\">\n    <div style=\"font-size:14px;letter-spacing:1px;color:#60a5fa;text-transform:uppercase;font-weight:bold;margin-bottom:10px;\">Short Answer Feedback</div>\n    <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"font-size:14px;\">\n      <tr><td style=\"padding:12px;border-bottom:1px solid #1f2937;\">\n        <span style=\"color:#ffffff;font-weight:bold;\">Q1</span> <span style=\"color:#3b82f6;\">({{ $json.short_scores.q1 }}/3)</span>\n        <div style=\"color:#9ca3af;margin-top:4px;line-height:1.5;\">{{ $json.feedback.q1 }}</div>\n      </td></tr>\n      <tr><td style=\"padding:12px;border-bottom:1px solid #1f2937;\">\n        <span style=\"color:#ffffff;font-weight:bold;\">Q2</span> <span style=\"color:#3b82f6;\">({{ $json.short_scores.q2 }}/3)</span>\n        <div style=\"color:#9ca3af;margin-top:4px;line-height:1.5;\">{{ $json.feedback.q2 }}</div>\n      </td></tr>\n      <tr><td style=\"padding:12px;border-bottom:1px solid #1f2937;\">\n        <span style=\"color:#ffffff;font-weight:bold;\">Q3</span> <span style=\"color:#3b82f6;\">({{ $json.short_scores.q3 }}/3)</span>\n        <div style=\"color:#9ca3af;margin-top:4px;line-height:1.5;\">{{ $json.feedback.q3 }}</div>\n      </td></tr>\n      <tr><td style=\"padding:12px;border-bottom:1px solid #1f2937;\">\n        <span style=\"color:#ffffff;font-weight:bold;\">Q4</span> <span style=\"color:#3b82f6;\">({{ $json.short_scores.q4 }}/3)</span>\n        <div style=\"color:#9ca3af;margin-top:4px;line-height:1.5;\">{{ $json.feedback.q4 }}</div>\n      </td></tr>\n      <tr><td style=\"padding:12px;\">\n        <span style=\"color:#ffffff;font-weight:bold;\">Q5</span> <span style=\"color:#3b82f6;\">({{ $json.short_scores.q5 }}/3)</span>\n        <div style=\"color:#9ca3af;margin-top:4px;line-height:1.5;\">{{ $json.feedback.q5 }}</div>\n      </td></tr>\n    </table>\n  </td></tr>\n\n  <!-- Footer -->\n  <tr><td style=\"padding:22px 28px 28px 28px;border-top:1px solid #1f2937;\">\n    <div style=\"font-size:14px;color:#9ca3af;line-height:1.6;\">Best regards,<br><span style=\"color:#60a5fa;font-weight:bold;\">Course Team</span></div>\n  </td></tr>\n\n</table>\n\n</td