    {
      "parameters": {
        "jsCode": "const PASS_MARK = 15;\nconst OUT_OF = 25;\n\n// AI যদি ```json ... ``` দিয়ে ঘিরে দেয়, সেটা কেটে শুধু JSON নেয়\nconst parseAI = (val) => {\n  if (typeof val !== \"string\") return val;\n  const cleaned = val\n    .replace(/```json/gi, \"\")\n    .replace(/```/g, \"\")\n    .trim();\n  const start = cleaned.indexOf(\"{\");\n  const end = cleaned.lastIndexOf(\"}\");\n  return JSON.parse(cleaned.slice(start, end + 1));\n};\n\nreturn $input.all().map(item => {\n  const r = parseAI(item.json.output ?? item.json);\n\n  const s = r.short_scores;\n  const shortTotal = s.q1 + s.q2 + s.q3 + s.q4 + s.q5;\n  const total = Number(r.mcq_score) + shortTotal;\n\n  return { json: {\n    ...r,\n    short_total: shortTotal,\n    total,\n    out_of: OUT_OF,\n    score_text: `${total} / ${OUT_OF}`,\n    percentage: Math.round((total / OUT_OF) * 100),\n    result: total >= PASS_MARK ? \"PASS\" : \"FAIL\",\n  }};\n});"
      },
